\f0\fs24 \cf0 # Script:   03_FAMD_UMAP_panels_freq_conj.R\
# Purpose:  FAMD on UMAP\uc0\u8209 derived frequencies or conjugates,\
#           MANOVA on first two dimensions, pairwise Wilcoxon tests,\
#           and variable vectors coloured by \'96log10 p for two panels:\
#           (i) freq_* variables, (ii) conj_* variables.\
#\
# Input:    CSV with:\
#           - status2          : grouping factor (e.g. positive versus negative for platelet-associated HIV RNA)\
#           - freq_* variables : frequency of each cell subset identified by unsupervised method. (e.g: "freq_CD4effector","freq_CD4memory","freq_RTECD4", freq_CD8effector","freq_CD8memory","freq_RTECD8"\
#           - conj_* variables : frequency of platelet conjugates among each cell subset identified by #unsupervised method. (e.g: "conj_CD4effector","conj_CD4memory","conj_RTECD4","conj_CD8effector","conj_CD8memory","conj_RTECD8\'94)\
\
# 0. Load packages\
\
library(FactoMineR)\
library(factoextra)\
library(missMDA)\
library(dplyr)\
library(ggplot2)\
library(cowplot)\
library(gridExtra)\
\
# 1. Load data\
\
idata <- read.delim(\'93data.csv\'94,\
                   sep = "\\t", dec = ",", stringsAsFactors = FALSE)\
data$status2 <- as.factor(data$status2)\
\
freq_cols <- c("freq_CD4effector","freq_CD4memory","freq_RTECD4",\
               "freq_CD8effector","freq_CD8memory","freq_RTECD8")\
conj_cols <- c("conj_CD4effector","conj_CD4memory","conj_RTECD4",\
               "conj_CD8effector","conj_CD8memory","conj_RTECD8")\
\
data[freq_cols] <- lapply(data[freq_cols], function(x) as.numeric(gsub(",", ".", x)))\
data[conj_cols] <- lapply(data[conj_cols], function(x) as.numeric(gsub(",", ".", x)))\
\
# 2. FAMD + stats (MANOVA, pairwise Wilcoxon) for a set of variables\
\
plot_famd_with_stats <- function(data, quanti_vars, group_var,\
                                 xlim_vec = c(-1, 1), ylim_vec = c(-1, 1))\{\
  \
  famd_data <- data %>% select(all_of(quanti_vars), all_of(group_var))\
  \
  res.impute <- imputeFAMD(famd_data, ncp = 2, method = "Regularized", maxiter = 1000)\
  res.famd <- FAMD(famd_data, tab.disj = res.impute$tab.disj, graph = FALSE)\
  \
  pca_plot <- fviz_mfa_ind(res.famd, habillage = group_var,\
                           palette = c("grey", "#56B4E9", "blue", "#E69F00", "red"),\
                           addEllipses = TRUE, ellipse.type = "confidence",\
                           repel = TRUE, label = "none", mean.point = FALSE) +\
    theme_classic() + coord_fixed(ratio = 1) + xlim(-4, 5) + ylim(-4, 6)\
  \
  coords <- as.data.frame(res.famd$ind$coord)\
  coords$group <- famd_data[[group_var]]\
  \
  fit <- manova(cbind(Dim.1, Dim.2) ~ group, data = coords)\
  print(summary(fit, test = "Wilks"))\
  \
  dim1 <- pairwise.wilcox.test(coords$Dim.1, coords$group, p.adjust.method = "BH")\
  dim2 <- pairwise.wilcox.test(coords$Dim.2, coords$group, p.adjust.method = "BH")\
  \
  dim1_df <- as.data.frame(as.table(dim1$p.value)) %>%\
    rename(group1 = Var1, group2 = Var2, pval_dim1 = Freq) %>%\
    filter(!is.na(pval_dim1))\
  \
  dim2_df <- as.data.frame(as.table(dim2$p.value)) %>%\
    rename(group1 = Var1, group2 = Var2, pval_dim2 = Freq) %>%\
    filter(!is.na(pval_dim2))\
  \
  combined_pvals <- inner_join(dim1_df, dim2_df, by = c("group1", "group2")) %>%\
    arrange(group1, group2)\
  \
  combined_pvals$pval_dim1 <- signif(combined_pvals$pval_dim1, 3)\
  combined_pvals$pval_dim2 <- signif(combined_pvals$pval_dim2, 3)\
  colnames(combined_pvals)[3:4] <- c("Wilcox p-val Dim 1", "Wilcox p-val Dim 2")\
  \
  pvals_grob <- tableGrob(combined_pvals, rows = NULL)\
  \
  combined_pca_stats <- plot_grid(\
    pvals_grob, pca_plot,\
    ncol = 2, rel_widths = c(0.45, 0.55)\
  )\
  \
  quanti_coords <- as.data.frame(res.famd$quanti.var$coord[, 1:2])\
  quanti_coords$var <- rownames(quanti_coords)\
  \
  pvals_vec <- sapply(quanti_coords$var, function(v) \{\
    y <- famd_data[[v]]\
    fit_aov <- aov(y ~ famd_data[[group_var]])\
    summary(fit_aov)[[1]][["Pr(>F)"]][1]\
  \})\
  \
  quanti_coords$pval <- pvals_vec\
  quanti_coords$neglog10p <- pmin(-log10(quanti_coords$pval), 10)\
  \
  quanti_plot_p <- ggplot(quanti_coords,\
                          aes(x = Dim.1, y = Dim.2,\
                              xend = 0, yend = 0,\
                              color = neglog10p)) +\
    geom_segment(aes(x = 0, y = 0, xend = Dim.1, yend = Dim.2), arrow = arrow(length = unit(0.3, "cm")), size = 1) +\
    geom_text(aes(label = var),\
              hjust = 0, vjust = 0, size = 3, color = "black",\
              nudge_x = 0.02, nudge_y = 0.02) +\
    geom_vline(xintercept = 0, linetype = "dashed", color = "lightgrey") +\
    geom_hline(yintercept = 0, linetype = "dashed", color = "lightgrey") +\
    scale_color_viridis_c(name = "-log10(p)", option = "C", limits = c(1, 3), oob = scales::squish) +\
    theme_classic() +\
    coord_fixed(ratio = 1) +\
    xlim(xlim_vec) + ylim(ylim_vec) +\
    xlab("Dim 1") + ylab("Dim 2") +\
    ggtitle("Quantitative variables colored by p value")\
  \
  list(\
    pca_with_stats = combined_pca_stats,\
    quanti_plot_p = quanti_plot_p\
  )\
\}\
\
# 3. Run for freq and conj panels\
\
# Example usage, adjust limits here as needed:\
freq_results <- plot_famd_with_stats(data, freq_cols, "status2",\
                                     xlim_vec = c(-0.8, 1), ylim_vec = c(-0.8, 1))\
conj_results <- plot_famd_with_stats(data, conj_cols, "status2",\
                                     xlim_vec = c(0, 1.5), ylim_vec = c(-0.5, 1))\
\
plot_grid(\
  freq_results$pca_with_stats, freq_results$quanti_plot_p,\
  conj_results$pca_with_stats, conj_results$quanti_plot_p,\
  labels = "AUTO", ncol = 2, align = "hv"\
)\
}