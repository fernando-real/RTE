
# Script:   01_ddPCR_GMM_thresholding_and_Poisson_LRT.R
# Purpose:  (i) Define a stringent RFU threshold using a 2‑component GMM
#           (ii) Classify ddPCR droplets
#           (iii) Compute per‑well Poisson rate ratio vs a negative control
#           (iv) Produce plate‑level RFU plots with threshold and p‑values
#
# Input:    CSV file with columns at least:
#           - Well        : 96‑well ID (e.g. "A1", "H3")
#           - Partition   : droplet/partition index
#           - RFU         : fluorescence

# 0. Load packages

library(mclust)
library(ggplot2)
library(tibble)
library(dplyr)
library(tidyr)
library(rateratio.test)
library(writexl)
library(epitools)

# load ddPCR data (edit for your system)
exp1  <- "data/data.csv"
exp=na.omit(exp1)

# 1. Define Threshold

# load data positive control (e.g. well G3)
pos <- exp %>% 
  filter(Well == "G3") %>%
  drop_na()
RFU <- as.numeric(pos$RFU)
RFU
hist(RFU, breaks = 1000, ylim = c(0,10)) 

# Fit a two-component Gaussian mixture model
gmm <- Mclust(RFU, G=2)

# Extract parameters
n_droplets <- length(RFU)
means <- gmm$parameters$mean
sds <- sqrt(gmm$parameters$variance$sigmasq)
props <- gmm$parameters$pro

# Order components: negative = lower mean, positive = higher mean
if (means[1] > means[2]) {
  means <- rev(means)
  sds <- rev(sds)
  props <- rev(props)}

# Ensure means[1] is the negative population
neg_mean <- means[1]
neg_sd <- sds[1]
pos_mean <- means[2]
pos_sd <- sds[2]

# Calculate separation factor (k)
separation_factor <- abs(pos_mean - neg_mean) / sqrt((neg_sd^2 + pos_sd^2)/2)
cat("Separation factor (k):", separation_factor, "\n")

# Set a restrictive threshold: e.g., 4 SDs above negative mean
n_sd <- 10  # ADJUST! Increase for even more restrictiveness
threshold <- neg_mean + n_sd * neg_sd

# Classify droplets
is_positive <- RFU > threshold
n_pos <- sum(is_positive)
n_neg <- n_droplets - n_pos

# Poisson statistics
lambda <- -log(n_neg / n_droplets)
copies_per_reaction <- lambda * n_droplets

# Output
cat("Proposed threshold:", threshold, "\n")
cat("Number of positive droplets:", n_pos, "\n")
cat("Number of negative droplets:", n_neg, "\n")
cat("Lambda (mean target copies per droplet):", lambda, "\n")
cat("Estimated total target copies in reaction:", copies_per_reaction, "\n")

# 2. Graphs

data <- exp
# Preview the data
head(data)
# Make sure the first column is a factor (grouping variable)
data[[1]] <- as.factor(data[[1]])
# Generate dot plot, grouped by 'Group'
data2 <- data %>%
  separate(Well, into = c("Row", "Column"), sep = 1, remove = FALSE)
ggplot(data2, aes(x = Partition, y = RFU)) +
  geom_jitter(width = 0.5, size = 0.3, alpha = 0.2, fill = "black", colour = "black") +
  labs(title = "RFU per sample",
       x = "Partition",
       y = "RFU") +
  facet_grid(Row ~ Column, scales = "fixed") +
  coord_cartesian(ylim = c(20, 150)) + 
  geom_hline(yintercept = threshold, linetype = "solid", color = "red", size = 0.5) +
  theme_bw() +
  theme(legend.position = "none")

# 3. Statistics per sample

# Classify droplets as positive or negative
exp2 <- exp %>%
  mutate(is_positive = RFU > threshold)
# Summarize per well: count positives and total droplets
well_summary <- exp2 %>%
  group_by(Well) %>%
  summarise(
    positives = sum(is_positive),
    droplets = n(), .groups = 'drop')
# Define your reference well for negative control (e.g., well H3)
ref_well <- "H3"
ref_data <- well_summary %>% filter(Well == ref_well)

# Likelihood ratio test (LRT) function for Poisson rates
run_lrt_rateratio <- function(positives, droplets, ref_pos, ref_droplets) {
  rate_well <- positives / droplets
  rate_ref <- ref_pos / ref_droplets
  
  total_pos <- positives + ref_pos
  total_droplets <- droplets + ref_droplets
  pooled_rate <- total_pos / total_droplets
  
  ll_null <- dpois(positives, lambda = droplets * pooled_rate, log = TRUE) +
    dpois(ref_pos, lambda = ref_droplets * pooled_rate, log = TRUE)
  
  ll_alt <- dpois(positives, lambda = droplets * rate_well, log = TRUE) +
    dpois(ref_pos, lambda = ref_droplets * rate_ref, log = TRUE)
  
  lr_stat <- 2 * (ll_alt - ll_null)
  
  # One-sided p-value (greater alternative)
  p_value <- ifelse(rate_well > rate_ref, pchisq(lr_stat, df = 1, lower.tail = FALSE) / 2, 1)
  
  tibble(
    rate_ratio = rate_well / rate_ref,
    rate_well = rate_well,
    rate_ref = rate_ref,
    lower_CI = NA,   # You can add CI calculation separately
    upper_CI = NA,
    p_value = p_value
  )
}
# Apply the LRT to all wells except the reference
results <- well_summary %>%
  filter(Well != ref_well) %>%
  rowwise() %>%
  mutate(
    stats = list(run_lrt_rateratio(positives, droplets, ref_data$positives, ref_data$droplets))
  ) %>%
  unnest(cols = c(stats))

# Add the reference well with NA for stats
ref_row <- well_summary %>%
  filter(Well == ref_well) %>%
  mutate(rate_ratio = NA, rate_well = NA, rate_ref = NA, lower_CI = NA, upper_CI = NA, p_value = NA)

final_results <- bind_rows(ref_row, results)

final_results <- final_results %>%
  mutate(signif = ifelse(p_value < 0.05, "*", ""))
final_results <- final_results %>%
  # Extract well row (letter) and column (number)
  mutate(
    well_row = substr(Well, 1, 1),
    well_col = as.integer(substr(Well, 2, nchar(Well)))
  ) %>%
  # Arrange by row alphabetically and then column numerically
  arrange(well_row, well_col) %>%
  # Drop temporary columns if you prefer
  select(-well_row, -well_col)

print(final_results, n=Inf)

# Generate dot plot, grouped by 'Group'

pval_df <- final_results %>%
  mutate(
    Row = substr(Well, 1, 1),
    Column = substr(Well, 2, nchar(Well)),
    label = paste0("p = ", signif(p_value, 2)),
    x = 5000,       # Choose an x value that is visible in your plot
    y = 130      # Choose a y value near the top of your y-axis
  )

ggplot(data2, aes(x = Partition, y = RFU)) +
  geom_jitter(width = 0.5, size = 0.3, alpha = 0.2, fill = "black", colour = "black") +
  labs(title = "Poisson rate ratio test per sample",
       x = "Partition",
       y = "RFU") +
  facet_grid(Row ~ Column, scales = "fixed") +
  coord_cartesian(ylim = c(20, 150)) + 
  geom_hline(yintercept = threshold, linetype = "solid", color = "red", size = 0.5) +
  theme_bw() +
  theme(legend.position = "none")+
  geom_text(
    data = pval_df,
    aes(x = x, y = y, label = label),
    inherit.aes = FALSE,
    size = 3
  )

writexl::write_xlsx(final_results, "output/final_results.xlsx")
