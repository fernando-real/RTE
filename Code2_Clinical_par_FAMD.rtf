\f0\fs24 \cf0 # Script:   02_FAMD_clinical_status2.R\
# Purpose:  FAMD on clinical dataset, MANOVA on first two dimensions,\
#           pairwise Wilcoxon tests by status, and variable\uc0\u8209 level ANOVA\
#           with vector plot of quantitative loadings coloured by \'96log10 p.\
#\
# Input:    CSV with:\
#           - status2 : grouping factor (e.g. positive versus negative for platelet-associated HIV RNA)\
#           - other clinical variables (numeric or categorical)\
\
# 0. Load packages\
\
library(FactoMineR)\
library(factoextra)\
library(missMDA)\
library(dplyr)\
library(ggplot2)\
library(cowplot)\
library(gridExtra)\
\
#1. Load clinical data (edit path/format as needed)\
data  <- "data/data.csv\'94\
\pard\tx593\pardeftab593\partightenfactor0
\cf0 ddata$sex <- as.factor(data$sex)\
\pard\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\pardirnatural\partightenfactor0
\cf0 data$status <- as.factor(data$status) #also for other categorical variables\
\
# 3. FAMD with imputation\
res.impute <- imputeFAMD(data, ncp = 2, method=c("Regularized"), row.w = NULL,\
                         coeff.ridge=1,threshold = 1e-06, ind.sup=NULL, sup.var=NULL,\
                         seed = NULL, maxiter = 1000)\
res.famd <- FAMD(data, tab.disj = res.impute$tab.disj, graph = FALSE)\
res.famd\
\
pca_plot <- fviz_mfa_ind(res.famd, habillage = "status2",\
                         palette = c("grey", "#56B4E9", "blue", "#E69F00", "red"),\
                         addEllipses =TRUE, ellipse.type = "confidence",\
                         repel = TRUE, label = "none", mean.point = FALSE) +\
  theme_classic() +\
  coord_fixed(ratio = 1) +\
  xlim(-3.5, 5.5) + ylim(-3.5, 6)\
\
plot(pca_plot)\
\
# 4. Individual plot + MANOVA + pairwise Wilcoxon\
\
coords <- as.data.frame(res.famd$ind$coord)\
coords$group <- data$status2\
\
fit <- manova(cbind(Dim.1, Dim.2) ~ group, data = coords)\
print(summary(fit, test = "Wilks"))\
dim1 <- pairwise.wilcox.test(coords$Dim.1, coords$group, p.adjust.method = "BH")\
dim2 <- pairwise.wilcox.test(coords$Dim.2, coords$group, p.adjust.method = "BH") \
\
dim1_df <- as.data.frame(as.table(dim1$p.value)) %>%\
  rename(group1 = Var1, group2 = Var2, pval_dim1 = Freq) %>%\
  filter(!is.na(pval_dim1))\
dim2_df <- as.data.frame(as.table(dim2$p.value)) %>%\
  rename(group1 = Var1, group2 = Var2, pval_dim2 = Freq) %>%\
  filter(!is.na(pval_dim2))\
combined_pvals <- inner_join(dim1_df, dim2_df, by = c("group1", "group2")) %>%\
  arrange(group1, group2)\
\
combined_pvals$pval_dim1 <- signif(combined_pvals$pval_dim1, 3)\
combined_pvals$pval_dim2 <- signif(combined_pvals$pval_dim2, 3)\
colnames(combined_pvals)[3:4] <- c("Wilcox p-val Dim 1", "Wilcox p-val Dim 2")\
pvals_grob <- tableGrob(combined_pvals, rows = NULL)\
\
combined_pca_stats <- plot_grid(\
  pvals_grob, pca_plot,\
  nrow = 2, rel_heights = c(0.45, 0.55))\
  \
quanti_coords <- as.data.frame(res.famd$quanti.var$coord[, 1:2])\
quanti_coords$var <- rownames(quanti_coords)\
\
pvals_vec <- sapply(quanti_coords$var, function(v) \{\
  y <- data[[v]]\
  fit_aov <- aov(y ~ data$status2)\
  summary(fit_aov)[[1]][["Pr(>F)"]][1]\
\}) \
quanti_coords$pval <- pvals_vec\
quanti_coords$neglog10p <- pmin(-log10(quanti_coords$pval), 10)\
\
quanti_plot_p <- ggplot(quanti_coords, aes(color = neglog10p)) +\
  geom_segment(aes(x = 0, y = 0, xend = Dim.1, yend = Dim.2),\
               arrow = arrow(length = unit(0.3, "cm")), size = 1) +\
  geom_text(aes(x = Dim.1, y = Dim.2, label = var),\
            hjust = 0, vjust = 0, size = 3, color = "black",\
            nudge_x = 0.02, nudge_y = 0.02) +\
  geom_vline(xintercept = 0, linetype = "dashed", color = "lightgrey") +\
  geom_hline(yintercept = 0, linetype = "dashed", color = "lightgrey") +\
  scale_color_viridis_c(name = "-log10(p)", option = "plasma", limits = c(0, 10), oob = scales::squish) +\
  theme_classic() +\
  coord_fixed(ratio = 1) +\
  xlab("Dim 1") + ylab("Dim 2") +\
  ggtitle("Quantitative variables colored by p value") \
  \
list(\
  pca_with_stats = combined_pca_stats,\
  quanti_plot_p = quanti_plot_p) \
\
# 5. Plot combined PCA + stats table & vector plot side by side\
plot_grid(\
  combined_pca_stats,\
  quanti_plot_p,\
  ncol = 2,\
  rel_widths = c(0.55, 0.45),\
  labels = c("A", "B"))\
\
}